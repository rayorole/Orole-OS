# Server-side only — never exposed to the browser.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# Hermes gateway (OpenAI-compatible). The panel proxies to it via /api/gateway/*;
# the admin key is only held in server memory, never in the browser.
HERMES_GATEWAY_URL=

# Server port
PORT=8787
